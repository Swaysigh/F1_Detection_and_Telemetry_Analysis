# --- Data (never version raw/processed data) ---
data/raw/*
data/interim/*
data/processed/*
data/annotations/*
!data/**/.gitkeep

# --- Models / weights ---
models/checkpoints/*
models/pretrained/*
!models/**/.gitkeep
*.pt
*.pth
*.onnx
*.h5
*.weights

# --- Outputs (regenerable) ---
outputs/logs/*
outputs/predictions/*
outputs/videos/*
!outputs/**/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# --- Environments ---
venv/
.venv/
env/
.env

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Video / large media (double safety net) ---
*.mp4
*.avi
*.mov
*.mkv

# --- Training runs (regenerable) ---
runs/